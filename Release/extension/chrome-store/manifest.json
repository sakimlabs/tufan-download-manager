{
    "manifest_version":  3,
    "default_locale":  "en",
    "name":  "__MSG_name__",
    "version":  "4.6.0",
    "description":  "__MSG_description__",
    "homepage_url":  "https://sakimlabs.github.io/tufan-download-manager/",
    "minimum_chrome_version":  "116",
    "permissions":  [
                        "downloads",
                        "contextMenus",
                        "nativeMessaging",
                        "cookies",
                        "storage",
                        "webRequest",
                        "scripting",
                        "declarativeNetRequestWithHostAccess",
                        "proxy"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "__MSG_name__",
                   "default_icon":  {
                                        "16":  "icons/tdm-icon-16.png",
                                        "32":  "icons/tdm-icon-32.png"
                                    }
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "video.js"
                                       ],
                                "all_frames":  true,
                                "run_at":  "document_idle"
                            },
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "page.js"
                                       ],
                                "all_frames":  true,
                                "run_at":  "document_start"
                            }
                        ],
    "icons":  {
                  "16":  "icons/tdm-icon-16.png",
                  "32":  "icons/tdm-icon-32.png",
                  "48":  "icons/tdm-icon-48.png",
                  "128":  "icons/tdm-icon-128.png"
              }
}